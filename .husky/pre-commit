#!/bin/sh

# Bunのパスを明示的に追加
export PATH="/home/eita/.nodebrew/current/bin:$PATH"

bunx lint-staged
bunx repomix

# agent_contexts/ 以下のファイルが変更されていれば自動的にステージングする
if [ -d "agent_contexts" ]; then
  changed_files=$(git diff --name-only agent_contexts/)
  if [ -n "$changed_files" ]; then
    git add agent_contexts/
  fi
fi